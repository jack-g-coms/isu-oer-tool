generator client {
  provider = "prisma-client"
  output   = "./"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  extensions = [vector]
}

// Auth
model User {
  id String @id @default(cuid())
  name String
  email String @unique
  department String?
  image String?

  documents KnowledgeDocument[]
  textbooks Textbook[]
}

// RAG & Knowledge Base
enum KnowledgeDocumentType {
  PDF
  DOCX
  PPTX
  TEXT
}

enum KnowledgeDocumentStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}

model KnowledgeDocument {
  id String @id @default(cuid())
  title String
  status KnowledgeDocumentStatus @default(QUEUED)
  type KnowledgeDocumentType
  authorId String
  uploadKey String
  class String @default("None")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks KnowledgeDocumentChunk[]
  referencedIn Textbook[]

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model KnowledgeDocumentChunk {
  id String @id @default(cuid())
  documentId String
  index Int
  text String

  embedding Unsupported("vector(768)")
  createdAt DateTime @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// Textbooks
enum TextbookStatus {
  QUEUED
  OUTLINING
  READY
  FAILED_OUTLINING
}

enum SectionStatus {
  QUEUED
  WRITING
  READY
  FAILED_WRITING
  FAILED_REFINING
}

model Textbook {
  id String @id @default(cuid())
  title String?
  authorId String
  description String?

  status TextbookStatus @default(QUEUED)

  sources KnowledgeDocument[]
  chapters Chapter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Chapter {
  id String @id @default(cuid())

  textbookId String
  textbook Textbook @relation(fields: [textbookId], references: [id], onDelete: Cascade)

  title String
  summary String?
  order Int
  sections Section[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 
}

model Section {
  id String @id @default(cuid())

  chapterId String
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  status SectionStatus @default(QUEUED)

  title String
  summary String?
  order Int

  content Json?
}